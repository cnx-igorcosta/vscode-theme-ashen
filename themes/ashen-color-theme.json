    },
    {
      "name": "Markdown - enfase",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#bebab4", "fontStyle": "italic" }
    },
    {
      "name": "Markdown - negrito",
      "scope": ["markup.bold", "markup.bold string"],
      "settings": { "foreground": "#e3dac9", "fontStyle": "bold" }
    },
    {
      "name": "Markdown - riscado",
      "scope": ["markup.strikethrough"],
      "settings": { "foreground": "#5e5853", "fontStyle": "strikethrough" }
    },
    {
      "name": "Markdown - links",
      "scope": [
        "markup.underline.link",
        "string.other.link.title.markdown",
        "constant.other.reference.link.markdown"
      ],
      "settings": { "foreground": "#937f88" }
    },
    {
      "name": "Markdown - codigo e citacao",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block",
        "markup.raw.block"
      ],
      "settings": { "foreground": "#5a6055" }
    },
    {
      "name": "Markdown - lista e citacao",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "markup.quote",
