        "constant.other.table-name.sql"
      ],
      "settings": { "foreground": "#93867f" }
    },

    {
      "name": "Shell - variaveis e comandos",
      "scope": [
        "variable.other.normal.shell",
        "variable.other.special.shell",
        "punctuation.definition.variable.shell",
        "support.function.builtin.shell",
        "entity.name.function.shell"
      ],
      "settings": { "foreground": "#93867f" }
    },
    {
      "name": "Shell - interpolacao",
      "scope": [
        "punctuation.definition.evaluation.backticks.shell",
        "meta.scope.subshell.shell"
      ],
      "settings": { "foreground": "#bebab4" }
    },

    {
      "name": "Python - self / dunder / decorators",
      "scope": [
        "variable.parameter.function.language.special.self.python",
        "support.variable.magic.python",
        "support.function.magic.python",
        "meta.function.decorator.python support.type.python"
      ],
      "settings": { "foreground": "#937f88", "fontStyle": "italic" }
    },
    {
      "name": "Python - f-string placeholders",
      "scope": ["meta.fstring.python constant.character.format.placeholder"],
      "settings": { "foreground": "#bebab4" }
    },

    {
      "name": "Go - package / builtin",
      "scope": [
        "keyword.package.go",
        "keyword.import.go",
        "support.function.go",
        "keyword.function.go",
        "keyword.type.go"
      ],
      "settings": { "foreground": "#937f88" }
