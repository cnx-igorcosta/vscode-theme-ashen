        "entity.name.type.go",
        "storage.type.string.go",
        "string.quoted.raw.go"
      ],
      "settings": { "foreground": "#93867f" }
    },

    {
      "name": "Rust - lifetimes / macros / traits",
      "scope": [
        "storage.modifier.lifetime.rust",
        "entity.name.type.lifetime.rust",
