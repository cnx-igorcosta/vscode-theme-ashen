      "settings": { "foreground": "#5a6055" }
    },
    {
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": { "foreground": "#78353f" }
    },
    {
      "scope": ["markup.changed", "meta.diff.header"],
      "settings": { "foreground": "#937f88" }
    },

    {
      "name": "YAML / TOML / INI - chaves",
      "scope": [
        "entity.name.tag.yaml",
        "support.type.property-name.yaml",
        "keyword.other.definition.ini",
        "entity.name.tag.toml",
        "support.type.property-name.table.toml"
      ],
      "settings": { "foreground": "#e3dac9" }
    },
    {
      "name": "YAML - ancoras e aliases",
      "scope": [
        "entity.name.type.anchor.yaml",
        "variable.other.alias.yaml",
        "punctuation.definition.anchor.yaml"
      ],
      "settings": { "foreground": "#937f88" }
    },

    {
      "name": "SQL - keywords",
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.DDL.sql",
        "keyword.other.sql",
        "keyword.other.create.sql",
        "keyword.other.alter.sql",
        "storage.type.sql"
      ],
      "settings": { "foreground": "#937f88" }
    },
    {
      "name": "SQL - funcoes e tabelas",
      "scope": [
        "support.function.aggregate.sql",
        "support.function.scalar.sql",
