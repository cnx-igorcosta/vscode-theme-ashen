    {
      "name": "TS/JS - tipos primitivos e genericos",
      "scope": [
        "support.type.primitive",
        "support.type.builtin",
        "entity.name.type.parameter",
        "meta.type.parameters entity.name.type"
      ],
      "settings": { "foreground": "#93867f" }
    },
    {
      "name": "JSX/TSX - componentes",
      "scope": [
        "support.class.component",
        "entity.name.tag.jsx",
        "entity.name.tag.tsx",
        "support.class.component.tsx"
      ],
      "settings": { "foreground": "#93867f" }
    },

    {
      "name": "Invalido / deprecado",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#78353f" }
    },
    {
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#6a5037", "fontStyle": "strikethrough" }
    },
    {
      "name": "Token colorido de log / terminal links",
      "scope": ["token.info-token", "http.requestline"],
      "settings": { "foreground": "#bebab4" }
    },
    {
      "scope": ["token.warn-token"],
      "settings": { "foreground": "#6a5037" }
    },
    {
      "scope": ["token.error-token"],
      "settings": { "foreground": "#78353f" }
    },
    {
      "scope": ["token.debug-token"],
      "settings": { "foreground": "#937f88" }
    }
  ],

  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#93867f",
    "interface": "#93867f",
    "enum": "#93867f",
    "struct": "#93867f",
    "type": "#93867f",
    "typeParameter": "#93867f",
    "namespace": "#8a827a",
    "function": "#e3dac9",
    "method": "#e3dac9",
    "macro": "#93867f",
    "variable": "#e3dac9",
    "parameter": "#c7bfb4",
    "property": "#d4cbbc",
    "enumMember": { "foreground": "#93867f", "fontStyle": "" },
    "event": "#93867f",
    "decorator": "#93867f",
    "annotation": "#93867f",
    "keyword": "#937f88",
    "string": "#5a6055",
    "number": "#e3dac9",
    "regexp": "#7f9393",
    "operator": "#8a827a",
    "comment": { "foreground": "#5e5853", "fontStyle": "italic" },
    "*.readonly": { "foreground": "#93867f", "fontStyle": "" },
    "*.static": { "fontStyle": "" },
    "*.static.readonly": { "foreground": "#93867f", "fontStyle": "" },
    "variable.readonly": { "foreground": "#93867f", "fontStyle": "" },
    "property.readonly": { "foreground": "#93867f", "fontStyle": "" },
    "*.declaration": {},
    "*.deprecated": { "strikethrough": true },
    "*.abstract": { "fontStyle": "italic" },
    "variable.defaultLibrary": "#937f88",
    "function.defaultLibrary": "#93867f",
    "class.defaultLibrary": "#93867f",
    "type.defaultLibrary": "#93867f",
    "selfKeyword": "#937f88"
  }
}
